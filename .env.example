# Beta list (/api/join)
BENTO_PUBLISHABLE_KEY=
BENTO_SECRET_KEY=
BENTO_SITE_UUID=

# Store (/api/checkout, /api/portal, /api/stripe/webhook). See docs/STRIPE.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 32+ random bytes; license keys are HMAC(LICENSE_SECRET, customer:subject). Rotating it changes every key.
LICENSE_SECRET=
# Build-time flag: "true" swaps the Pro card's beta CTA for buy buttons.
PUBLIC_STORE_OPEN=false
