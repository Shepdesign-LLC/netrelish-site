# Beta list (/api/join)
BENTO_PUBLISHABLE_KEY=
BENTO_SECRET_KEY=
BENTO_SITE_UUID=

# Store (/api/checkout, /api/portal, /api/stripe/webhook). See docs/STRIPE.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: bpc_… from scripts/stripe-portal.mjs. Unset opens the account's default portal configuration.
STRIPE_PORTAL_CONFIG=
# 32+ random bytes; license keys are HMAC(LICENSE_SECRET, customer:subject). Rotating it changes every key.
LICENSE_SECRET=
# Build-time flag: "true" swaps the Pro card's beta CTA for buy buttons.
PUBLIC_STORE_OPEN=false

# License relay (/api/license) for the direct build. Creem's secret API key; never ships in the app.
CREEM_API_KEY=
# Optional. Unset means production (https://api.creem.io). Only https://test-api.creem.io is accepted besides it.
CREEM_API_BASE=
