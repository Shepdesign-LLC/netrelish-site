---
// The homepage: Ryan's Zest-template design. The markup, styles and script live in src/home/ as plain files and are
// inlined untouched, so the design can be edited there without fighting Astro's template syntax. Hash routes
// (#home, #family, #pro, #workbench, #post-*, #roadmap) switch views in the browser; /roadmap, /privacy and the /api
// routes are unchanged.
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import body from '../home/body.html?raw';
import css from '../home/style.css?raw';
import js from '../home/script.js?raw';

// PUBLIC_STORE_OPEN=true shows direct-purchase buttons on the Pro view that post to /api/checkout. Off by default.
const storeOpen = import.meta.env.PUBLIC_STORE_OPEN === 'true';
const store = storeOpen
  ? `<form class="cta" method="post" action="/api/checkout" style="justify-content:center;margin:18px 0">
       <button class="btn zest" type="submit" name="plan" value="pro-year">Buy Pro · $39/yr</button>
       <button class="btn ghost" type="submit" name="plan" value="pro-lifetime">$99 once</button>
     </form>`
  : '';
const html = body.replace('<!--STORE-->', store);

const title = 'NetRelish: the native macOS workbench';
const description = 'NetRelish, the native macOS workbench. Savor the web. Get more done.';
const url = new URL('/', Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={url} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={new URL('/og.png', Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="color-scheme" content="dark" />
  <style is:inline set:html={css}></style>
</head>
<body>
  <Fragment set:html={html} />
  <script is:inline set:html={js}></script>
</body>
</html>
